# folder_actions configuration. Copy to .env and adjust. Never commit .env.
# Shared cross-service keys keep the FILEENGINE_* prefix; service-private keys use FA_*.

# --- gRPC core (SHARED) ---
FILEENGINE_GRPC_HOST=localhost
FILEENGINE_GRPC_PORT=50051

# --- This service's action principal (§7.5) — a dedicated LDAP account with rights
#     to Move/SetMetadata on the folders it manages. NOT system_admin. Falls back to
#     the shared FILEENGINE_LDAP_USER/PASSWORD if unset. ---
FILEENGINE_FA_TENANT=default
FILEENGINE_FA_USER=
FILEENGINE_FA_PASSWORD=

# --- LDAP (SHARED) ---
FILEENGINE_LDAP_ENDPOINT=ldap://localhost:1389
FILEENGINE_LDAP_DOMAIN=dc=rationalboxes,dc=com
FILEENGINE_LDAP_USER_BASE=ou=users,dc=rationalboxes,dc=com
FILEENGINE_LDAP_TENANT_BASE=ou=tenants,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_DN=cn=admin,dc=rationalboxes,dc=com
FILEENGINE_LDAP_BIND_PASSWORD=admin

# --- This service's own Postgres (PRIVATE) ---
FA_PG_HOST=localhost
FA_PG_PORT=5432
FA_PG_DATABASE=folder_actions
FA_PG_USER=fileengine_user
FA_PG_PASSWORD=fileengine_password

# --- HTTP surface (loopback by default; the container overrides to 0.0.0.0) ---
FA_HTTP_HOST=127.0.0.1
FA_HTTP_PORT=8099
# FA_CORS_ORIGINS=https://app.example.com
# Restrict unauthenticated /healthz /readyz /poolz to these IPs (loopback convention).
# FILEENGINE_MONITORING_ALLOW_IPS=127.0.0.1,::1

# --- Auth: accept http_bridge bearer tokens (SHARED secret for local HS256 verify) ---
FILEENGINE_JWT_SECRET=
# FA_BRIDGE_URL=http://localhost:8090

# --- Events: consume the shared recognized stream with a private group ---
FILEENGINE_REDIS_HOST=localhost
FILEENGINE_REDIS_PORT=6379
FILEENGINE_REDIS_PASSWORD=
FILEENGINE_REDIS_DB=0
FILEENGINE_EVENTS_STREAM=fileengine:events
FA_EVENTS_GROUP=folder_actions
FA_CONSUMER_NAME=worker-1

# --- Reconcile sweep (§8): recovers work missed during a Redis outage or past
#     stream retention. Walks bound folders and re-drives recently-changed files
#     through the same dispatch path as the live consumer (idempotent). ---
FA_RECONCILE_ENABLED=true
FA_RECONCILE_INTERVAL_S=900
# Widest window one sweep may cover; also the very first sweep's reach.
FA_RECONCILE_LOOKBACK_S=86400
# Re-scan margin before the last watermark, so a file written mid-sweep isn't missed.
FA_RECONCILE_OVERLAP_S=300
# Per-tenant work bound. Hitting it holds the watermark so the next sweep resumes.
FA_RECONCILE_MAX_FILES=5000
# Depth bound for recursive bindings' subtree walk.
FA_RECONCILE_MAX_DEPTH=32

# --- convert_search_ai (sorter text + rendition convert) ---
FA_CSAI_BASE_URL=http://localhost:8092

# --- Plug-ins + webhook secret box ---
# Restrict which registered actions are active (comma-separated); empty = all.
# FA_ENABLED_ACTIONS=move_review,notify,sorter,webhook
# Fernet key for encrypting webhook secrets at rest (generate with SecretBox.generate_key()).
FA_SECRET_KEY=

# --- SMTP (notify action) — leave FA_SMTP_HOST empty to log instead of send ---
FA_SMTP_HOST=
FA_SMTP_PORT=587
FA_SMTP_USER=
FA_SMTP_PASSWORD=
FA_SMTP_FROM=no-reply@rationalboxes.com
# Base URL for SPA deep-links in notification emails.
# FA_FRONTEND_BASE_URL=https://app.example.com

# discussion service (raise_review action)
FA_DISCUSS_BASE_URL=http://localhost:8094
